    </div>\n      \n      \n      <div data-kid=\"353\">\n        <h4 class=\"font-700 mb-4 text-sm uppercase tracking-wide\" style=\"font-family:'Quicksand',sans-serif; color:white; font-weight:700; letter-spacing:1px;\" data-kid=\"354\">Dịch vụ</h4>\n        <ul class=\"flex flex-col gap-3\" data-kid=\"355\">\n          <li data-kid=\"356\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"357\">Đặt vé xe khách</a></li>\n          <li data-kid=\"358\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"359\">Tìm kiếm chuyến đi</a></li>\n          <li data-kid=\"360\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"361\">Theo dõi xe trực tiếp</a></li>\n          <li data-kid=\"362\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"363\">Hủy / Đổi vé</a></li>\n          <li data-kid=\"364\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"365\">Vé xe tết</a></li>\n        </ul>\n      </div>\n      \n      \n      <div data-kid=\"366\">\n        <h4 class=\"font-700 mb-4 text-sm uppercase tracking-wide\" style=\"font-family:'Quicksand',sans-serif; color:white; font-weight:700; letter-spacing:1px;\" data-kid=\"367\">Hỗ trợ</h4>\n        <ul class=\"flex flex-col gap-3\" data-kid=\"368\">\n          <li data-kid=\"369\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"370\">Trung tâm trợ giúp</a></li>\n          <li data-kid=\"371\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"372\">Liên hệ chúng tôi</a></li>\n          <li data-kid=\"373\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"374\">Chính sách hoàn tiền</a></li>\n          <li data-kid=\"375\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"376\">Điều khoản sử dụng</a></li>\n          <li data-kid=\"377\"><a href=\"#\" class=\"text-sm\" style=\"color:#c4a898;\" data-kid=\"378\">Chính sách bảo mật</a></li>\n        </ul>\n      </div>\n      \n      \n      <div data-kid=\"379\">\n        <h4 class=\"font-700 mb-4 text-sm uppercase tracking-wide\" style=\"font-family:'Quicksand',sans-serif; color:white; font-weight:700; letter-spacing:1px;\" data-kid=\"380\">Liên hệ</h4>\n        <ul class=\"flex flex-col gap-3\" data-kid=\"381\">\n          <li class=\"flex items-center gap-2 text-sm\" style=\"color:#c4a898;\" data-kid=\"382\">\n            <i class=\"ti ti-phone\" style=\"color:#e85d04; font-size:16px;\" data-kid=\"383\"></i>\n            1800 1234\n          </li>\n          <li class=\"flex items-center gap-2 text-sm\" style=\"color:#c4a898;\" data-kid=\"384\">\n            <i class=\"ti ti-mail\" style=\"color:#e85d04; font-size:16px;\" data-kid=\"385\"></i>\n            hello@busgovietnam.vn\n          </li>\n          <li class=\"flex items-center gap-2 text-sm\" style=\"color:#c4a898;\" data-kid=\"386\">\n            <i class=\"ti ti-clock\" style=\"color:#e85d04; font-size:16px;\" data-kid=\"387\"></i>\n            7:00 – 22:00 hàng ngày\n          </li>\n          <li class=\"flex items-center gap-2 text-sm\" style=\"color:#c4a898;\" data-kid=\"388\">\n            <i class=\"ti ti-map-pin\" style=\"color:#e85d04; font-size:16px;\" data-kid=\"389\"></i>\n            123 Lê Lợi, TP.HCM\n          </li>\n        </ul>\n      </div>\n    </div>\n    \n    \n    <div class=\"pt-8 flex items-center justify-between flex-wrap gap-4\" style=\"border-top:1px solid rgba(255,255,255,0.08);\" data-kid=\"390\">\n      <p class=\"text-sm\" style=\"color:#9a7d6e;\" data-kid=\"391\">© 2025 BusGo Việt Nam. Tất cả quyền được bảo lưu.</p>\n      <p class=\"text-sm\" style=\"color:#9a7d6e;\" data-kid=\"392\">Làm với ❤️ tại Việt Nam 🇻🇳</p>\n    </div>\n  </div>\n</footer>\n\n<style data-kid=\"393\">\n@keyframes pulse {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.5; transform: scale(1.3); }\n}\n</style>\n\n<script data-kid=\"394\">\ngsap.registerPlugin(ScrollTrigger);\n\n// Hero animations\ngsap.from('.hero-badge', { y: 20, duration: 0.7, ease: 'back.out(1.7)', delay: 0.1 });\ngsap.from('.hero-title', { y: 30, duration: 0.8, ease: 'power3.out', delay: 0.25 });\ngsap.from('.hero-sub', { y: 20, duration: 0.7, ease: 'power2.out', delay: 0.4 });\ngsap.from('.hero-search', { y: 30, duration: 0.8, ease: 'power3.out', delay: 0.55 });\ngsap.from('.hero-chips', { y: 15, duration: 0.6, ease: 'power2.out', delay: 0.7 });\ngsap.from('.hero-stats', { y: 15, duration: 0.6, ease: 'power2.out', delay: 0.85 });\n\n// Destination cards\ngsap.from('.dest-card', {\n  scrollTrigger: { trigger: '.dest-cards', start: 'top 80%' },\n  y: 40,\n  stagger: 0.12,\n  duration: 0.7,\n  ease: 'power3.out'\n});\n\n// Activity feed\ngsap.from('.activity-feed', {\n  scrollTrigger: { trigger: '.activity-feed', start: 'top 80%' },\n  x: -40,\n  duration: 0.8,\n  ease: 'power3.out'\n});\n\n// Why cards\ngsap.from('.why-card', {\n  scrollTrigger: { trigger: '.why-cards', start: 'top 80%' },\n  y: 30,\n  stagger: 0.1,\n  duration: 0.6,\n  ease: 'power3.out'\n});\n\n// Testimonials\ngsap.from('.testimonial', {\n  scrollTrigger: { trigger: '.testimonials', start: 'top 80%' },\n  y: 40,\n  stagger: 0.15,\n  duration: 0.7,\n  ease: 'power3.out'\n});\n\n// Partners\ngsap.from('.partner-pill', {\n  scrollTrigger: { trigger: '.partners', start: 'top 85%' },\n  y: 20,\n  stagger: 0.08,\n  duration: 0.5,\n  ease: 'back.out(1.5)'\n});\n</script>\n",
