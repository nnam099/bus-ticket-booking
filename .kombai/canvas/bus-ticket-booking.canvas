      "html": "\n<style data-kid=\"0\">\n@import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Nunito:wght@400;500;600;700;800&display=swap');\n\nbody {\n  background: #fdfbf7;\n  font-family: 'Nunito', sans-serif;\n  color: #4a3b32;\n  margin: 0;\n  padding: 0;\n}\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"2\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"3\"></script>\n\n\n<nav class=\"sticky top-0 z-50 w-full\" style=\"background: #fdfbf7; border-bottom: 1.5px solid #f0e6d8; backdrop-filter: blur(12px);\" data-kid=\"4\">\n  <div class=\"max-w-7xl mx-auto px-6 py-4 flex items-center justify-between\" data-kid=\"5\">\n    \n    <a href=\"#\" class=\"flex items-center gap-2\" data-kid=\"6\">\n      <div class=\"w-9 h-9 rounded-xl flex items-center justify-center\" style=\"background:#e85d04;\" data-kid=\"7\">\n        <i class=\"ti ti-bus text-white\" style=\"font-size:18px;\" data-kid=\"8\"></i>\n      </div>\n      <span class=\"text-xl font-bold\" style=\"font-family:'Quicksand',sans-serif; color:#4a3b32;\" data-kid=\"9\">BusGo <span style=\"color:#e85d04;\" data-kid=\"10\">Việt Nam</span></span>\n    </a>\n    \n    <div class=\"hidden md:flex items-center gap-2\" data-kid=\"11\">\n      <a href=\"#\" class=\"px-4 py-2 rounded-full text-sm font-600 transition-colors\" style=\"color:#4a3b32; font-weight:600; font-family:'Nunito',sans-serif;\" data-kid=\"12\">Trang chủ</a>\n      <a href=\"#\" class=\"px-4 py-2 rounded-full text-sm font-600\" style=\"color:#9a7d6e; font-weight:600;\" data-kid=\"13\">Lịch trình</a>\n      <a href=\"#\" class=\"px-4 py-2 rounded-full text-sm font-600\" style=\"color:#9a7d6e; font-weight:600;\" data-kid=\"14\">Vé của tôi</a>\n      <a href=\"#\" class=\"px-4 py-2 rounded-full text-