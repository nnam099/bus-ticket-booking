, opacity: 0, duration: 0.7, ease: \"power2.out\" });\n  gsap.from(\"#hero-heading\", { delay: 0.4, y: 30, opacity: 0, duration: 0.8, ease: \"power2.out\" });\n  gsap.from(\"#hero-sub\", { delay: 0.55, y: 20, opacity: 0, duration: 0.7, ease: \"power2.out\" });\n  gsap.from(\"#hero-card\", { delay: 0.7, y: 24, opacity: 0, duration: 0.8, ease: \"power2.out\" });\n  gsap.from(\"#hero-trust\", { delay: 0.9, y: 16, opacity: 0, duration: 0.6, ease: \"power2.out\" });\n\n  // Stats bar\n  gsap.from(\".stat-item\", {\n    scrollTrigger: { trigger: \"#stats-bar\", start: \"top 80%\" },\n    y: 30, opacity: 0, duration: 0.6, stagger: 0.1, ease: \"power2.out\"\n  });\n\n  // Route cards\n  gsap.from(\".route-card\", {\n    scrollTrigger: { trigger: \"#routes-section\", start: \"top 75%\" },\n    y: 40, opacity: 0, duration: 0.65, stagger: 0.08, ease: \"power2.out\"\n  });\n\n  // Feature cards\n  gsap.from(\".feature-card\", {\n    scrollTrigger: { trigger: \"#features-section\", start: \"top 75%\" },\n    y: 36, opacity: 0, duration: 0.65, stagger: 0.1, ease: \"power2.out\"\n  });\n\n  // Operator cards\n  gsap.from(\".operator-card\", {\n    scrollTrigger: { trigger: \"#operators-section\", start: \"top 80%\" },\n    y: 24, opacity: 0, duration: 0.55, stagger: 0.07, ease: \"power2.out\"\n  });\n\n  // CTA section\n  gsap.from(\"#cta-section h2\", {\n    scrollTrigger: { trigger: \"#cta-section\", start: \"top 75%\" },\n    x: -40, opacity: 0, duration: 0.8, ease: \"power2.out\"\n  });\n</script>\n",
