 align-items:center; gap:64px;\" data-kid=\"281\">\n    <div data-kid=\"282\">\n      <div style=\"font-family:'Roboto Mono',monospace; font-size:10px; letter-spacing:4px; color:#000; margin-bottom:12px; opacity:0.7;\" data-kid=\"283\">— TẢI ỨNG DỤNG</div>\n      <h2 style=\"font-family:'Playfair Display',serif; font-weight:900; font-size:52px; color:#000; margin:0 0 16px; letter-spacing:-2px; line-height:0.95;\" data-kid=\"284\">Đặt Vé Trên<br data-kid=\"285\"><em data-kid=\"286\">Di Động.</em></h2>\n      <p style=\"font-family:'Inter',sans-serif; font-size:15px; color:#000; line-height:1.7; margin:0 0 32px; opacity:0.8;\" data-kid=\"287\">Quản lý vé, tra cứu lịch trình và nhận thông báo chuyến xe mọi lúc, mọi nơi.</p>\n      <div style=\"display:flex; gap:12px;\" data-kid=\"288\">\n        <button style=\"background:#000; border:2px solid #000; color:#fff; padding:12px 24px; font-family:'Roboto Mono',monospace; font-size:11px; font-weight:700; letter-spacing:2px; cursor:pointer; box-shadow:4px 4px 0 #f4f4f0; display:flex; align-items:center; gap:10px;\" data-kid=\"289\">\n          <i class=\"ti ti-brand-apple\" style=\"font-size:18px;\" data-kid=\"290\"></i> APP STORE\n        </button>\n        <button style=\"background:transparent; border:2px solid #000; color:#000; padding:12px 24px; font-family:'Roboto Mono',monospace; font-size:11px; font-weight:700; letter-spacing:2px; cursor:pointer; box-shadow:4px 4px 0 #000; display:flex; align-items:center; gap:10px;\" data-kid=\"291\">\n          <i class=\"ti ti-brand-google-play\" style=\"font-size:18px;\" data-kid=\"292\"></i> GOOGLE PLAY\n        </button>\n      </div>\n    </div>\n    <div style=\"display:flex; justify-content:center; align-items:center;\" data-kid=\"293\">\n      <div style=\"background:#000; border:3px solid #000; padding:32px; box-shadow:8px 8px 0 #f4f4f0; position:relative;\" data-kid=\"294\">\n        <div style=\"font-family:'Roboto Mono',monospace; font-size:10px; letter-spacing:3px; col