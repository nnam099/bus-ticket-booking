      "html": "\n<style data-kid=\"0\">\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=Roboto+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap');\n\n.btn-hover-orange:hover {\n  background: #e85d04 !important;\n  color: #fff !important;\n}\n.nav-link:hover {\n  color: #e85d04 !important;\n}\n.dest-img-wrap {\n  overflow: hidden;\n}\n.dest-img-wrap img {\n  transition: transform 0.6s ease;\n}\n.dest-img-wrap:hover img {\n  transform: scale(1.04);\n}\n.feat-card:hover {\n  box-shadow: 6px 6px 0 #e85d04 !important;\n}\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"2\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"3\"></script>\n<script data-kid=\"4\">gsap.registerPlugin(ScrollTrigger);</script>\n\n<div style=\"background:#f4f4f0; font-family:'Inter',sans-serif; overflow-x:clip;\" data-kid=\"5\">\n\n  \n  <nav id=\"navbar\" style=\"background:#f4f4f0; border-bottom:2px solid #000; padding:0 64px; display:flex; align-items:center; justify-content:space-between; height:68px; position:sticky; top:0; z-index:100;\" data-kid=\"6\">\n    <div style=\"display:flex; align-items:center; gap:48px;\" data-kid=\"7\">\n      <div style=\"font-family:'Playfair Display',serif; font-weight:900; font-size:26px; letter-spacing:3px; color:#000; line-height:1;\" data-kid=\"8\">BUSGO<span style=\"color:#e85d04;\" data-kid=\"9\">.</span></div>\n      <div style=\"display:flex; gap:32px; font-family:'Inter',sans-serif; font-size:12px; font-weight:600; letter-spacing:1.5px; text-transform:uppercase;\" data-kid=\"10\">\n        <a href=\"#\" class=\"nav-link\" style=\"color:#000; text-decoration:none;\" data-kid=\"11\">Tuyến Đường</a>\n        <a href=\"#\" class=\"nav-link\" style=\"color:#000; text-decoration:none;\" data-kid=\"12\">Nhà Xe</a>\n        <a href=\"#\" class=\"nav-link\" style=\"color:#000; text-decoration:none;\" data-kid=\"13\">Lịch Chạy</a>\n        <a href=\"#\" class=\"nav-link\" style=\"color:#000; text-decoration:none;\" data-kid=\"14\">Hỗ Trợ</a>\n      </div>\n    </div>\n    <div style=\"display:flex; gap:10px; align-items:center;\" data-kid=\"15\">\n      <button style=\"background:transparent; border:2px solid #000; padding:8px 22px; font-family:'Inter',sans-serif; font-size:11px; font-weight:700; letter-spacing:1.5px; cursor:pointer; box-shadow:3px 3px 0 #000; text-transform:uppercase;\" data-kid=\"16\">ĐĂNG NHẬP</button>\n      <button style=\"background:#e85d04; border:2px solid #000; color:#fff; padding:8px 22px; font-family:'Inter',sans-serif; font-size:11px; font-weight:700; letter-spacing:1.5px; cursor:pointer; box-shadow:3px 3px 0 #000; text-transform:uppercase;\" data-kid=\"17\">ĐẶT VÉ →</button>\n    </div>\n  </nav>\n\n  \n  <section id=\"hero\" style=\"display:grid; grid-template-columns:1fr 1fr; min-height:640px; border-bottom:2px solid #000;\" data-kid=\"18\">\n    \n    <div id=\"hero-left\" style=\"padding:56px 60px 56px 64px; border-right:2px solid #000; display:flex; flex-direction:column; justify-content:space-between; background:#f4f4f0;\" data-kid=\"19\">\n      <div data-kid=\"20\">\n        \n        <div style=\"font-family:'Roboto Mono',monospace; font-size:10px; font-weight:700; letter-spacing:4px; color:#000; text-transform:uppercase; margin-bottom:24px; display:flex; align-items:center; gap:12px;\" data-kid=\"21\">\n          <span style=\"display:inline-block; width:32px; height:2px; background:#e85d04;\" data-kid=\"22\"></span>\n          VÉ XE KHÁCH VIỆT NAM — 2025\n        </div>\n        \n        <h1 id=\"hero-headline\" style=\"font-family:'Playfair Display',serif; font-weight:900; font-size:82px; line-height:0.92; color:#000; margin:0 0 0 0; letter-spacing:-3px;\" data-kid=\"23\">\n          HÀNH<br data-kid=\"24\">\n          TRÌNH<br data-kid=\"25\">\n          QUA<br data-kid=\"26\">\n          <span style=\"background:#fef08a; padding:2px 12px 6px; display:inline-block; margin-top:6px;\" data-kid=\"27\">VIỆT NAM.</span>\n        </h1>\n      </div>\n\n      \n      <div id=\"hero-form\" style=\"margin-top:36px;\" data-kid=\"28\">\n        <div style=\"font-family:'Roboto Mono',monospace; font-size:10px; letter-spacing:3px; color:#666; margin-bottom:14px; text-transform:uppercase;\" data-kid=\"29\">— Tìm chuyến xe của bạn</div>\n        <div style=\"display:flex; flex-direction:column; gap:8px;\" data-kid=\"30\">\n          <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:8px;\" data-kid=\"31\">\n            <div style=\"position:relative;\" data-kid=\"32\">\n              <span style=\"position:absolute; left:13px; top:50%; transform:translateY(-50%); font-size:15px; color:#000; line-height:1;\" data-kid=\"33\"><i class=\"ti ti-map-pin\" data-kid=\"34\"></i></span>\n              <input placeholder=\"Điểm đi\" style=\"width:100%; background:#fff; border:2px solid #000; border-radius:0; padding:13px 13px 13px 38px; font-family:'Inter',sans-serif; font-size:13px; box-shadow:4px 4px 0 #000; box-sizing:border-box; outline:none; font-weight:500;\" data-kid=\"35\">\n            </div>\n            <div style=\"position:relative;\" data-kid=\"36\">\n              <span style=\"position:absolute; left:13px; top:50%; transform:translateY(-50%); font-size:15px; color:#e85d04; line-height:1;\" data-kid=\"37\"><i class=\"ti ti-map-pin-filled\" data-kid=\"38\"></i></span>\n              <input placeholder=\"Điểm đến\" style=\"width:100%; background:#fff; border:2px solid #000; border-radius:0; padding:13px 13px 13px 38px; font-family:'Inter',sans-serif; font-size:13px; box-shadow:4px 4px 0 #000; box-sizing:border-box; outline:none; font-weight:500;\" data-kid=\"39\">\n            </div>\n          </div>\n          <div style=\"display:grid; grid