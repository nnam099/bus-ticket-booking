      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');\n\n  .font-space { font-family: 'Space Grotesk', sans-serif; }\n  .font-inter { font-family: 'Inter', sans-serif; }\n\n  @keyframes ticker-scroll {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n  .ticker-track {\n    display: flex;\n    animation: ticker-scroll 22s linear infinite;\n    width: max-content;\n  }\n\n  @keyframes pulse-dot {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.5; transform: scale(0.75); }\n  }\n  .pulse-dot {\n    animation: pulse-dot 1.8s ease-in-out infinite;\n  }\n\n  @keyframes route-line {\n    0% { width: 0; }\n    100% { width: 100%; }\n  }\n\n  .route-card:hover {\n    border-color: #e85d04 !important;\n    box-shadow: 0 4px 24px rgba(232,93,4,0.12);\n  }\n\n  .operator-card {\n    transition: border-color 0.2s, background 0.2s;\n  }\n  .operator-card:hover {\n    border-color: #e85d04 !important;\n    background: #fff7ed !important;\n  }\n  .route-card {\n    transition: border-color 0.2s, box-shadow 0.2s;\n  }\n  .feature-card {\n    transition: box-shadow 0.2s;\n  }\n  .feature-card:hover {\n    box-shadow: 0 6px 24px rgba(10,25,47,0.08) !important;\n  }\n\n  .btn-search:hover {\n    background: #c74e02 !important;\n  }\n\n  .nav-link:hover {\n    color: #e85d04 !important;\n  }\n\n  .social-icon:hover {\n    border-color: #e85d04 !important;\n    color: #e85d04 !important;\n  }\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"2\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"3\"></script>\n\n<div class=\"font-inter\" style=\"background:#ffffff;color:#0a192f;overflow-x:clip;\" data-kid=\"4\">\n\n  \n  <nav style=\"position:fixed;top:0;left:0;right:0;z-index:1000;background:#fff;border-bottom:1px solid #e2e8f0;height:64px;display:flex;align-items:center;padding:0 64px;\" data-kid=\"5\">\n    <div style=\"display:flex;align-items:center;gap:8px;flex:0 0 auto;\" data-kid=\"6\">\n      <span style=\"background:#e85d04;border-radius:6px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;\" data-kid=\"7\">\n        <i class=\"ti ti-bus\" data-kid=\"8\"></i>\n      </span>\n      <span class=\"font-space\" style=\"font-weight:700;font-size:22px;color:#0a192f;letter-spacing:-0.5px;\" data-kid=\"9\">BusGo</span>\n      <span class=\"font-space\" style=\"font-size:13px;color:#e85d04;font-weight:500;margin-left:1px;\" data-kid=\"10\">Việt Nam</span>\n    </div>\n\n    <div style=\"flex:1;display:flex;justify-content:center;gap:40px;\" data-kid=\"11\">\n      <a href=\"#\" class=\"nav-link font-inter\" style=\"text-decoration:none;font-size:14px;font-weight:500;color:#0a192f;\" data-kid=\"12\">Điểm đi</a>\n      <a href=\"#\" class=\"nav-link font-inter\" style=\"text-decoration:none;font-size:14px;font-weight:500;color:#e85d04;position:relative;\" data-kid=\"13\">Tìm chuyến\n        <span style=\"position:absolute;bottom:-4px;left:0;right:0;height:2px;background:#e85d04;border-radius:1px;\" data-kid=\"14\"></span>\n      </a>\n      <a href=\"#\" class=\"nav-link font-inter\" style=\"text-decoration:none;font-size:14px;font-weight:500;color:#0a192f;\" data-kid=\"15\">Tra cứu vé</a>\n      <a href=\"#\" class=\"nav-link font-inter\" style=\"text-decoration:none;font-size:14px;font-weight:500;color:#0a192f;\" data-kid=\"16\">Hỗ trợ</a>\n    </div>\n\n    <div style=\"flex:0 0 auto;display:flex;gap:12px;align-items:center;\" data-kid=\"17\">\n      <button class=\"font-inter\" style=\"border:1.5px solid #0a192f;background:transparent;color:#0a192f;font-size:13px;font-weight:600;padding:8px 22px;border-radius:3px;cursor:pointer;letter-spacing:0.2px;\" data-kid=\"18\">Đăng nhập</button>\n      <button class=\"font-inter\" style=\"background:#e85d04;color:#fff;font-size:13px;font-weight:600;padding:8px 22px;border-radius:3px;border:none;cursor:pointer;letter-spacing:0.2px;\" data-kid=\"19\">Đăng ký</button>\n    </div>\n  </nav>\n\n  \n  <section style=\"display:flex;height:100vh;padding-top:64px;\" data-kid=\"20\">\n\n    \n    <div id=\"hero-left\" style=\"width:42%;background:#fff;display:flex;flex-direction:column;justify-content:center;padding:56px 56px 56px 80px;position:relative;flex-shrink:0;\" data-kid=\"21\">\n      \n      <div style=\"position:absolute;inset:0;opacity:0.03;background-image:linear-gradient(#0a192f 1px,transparent 1px),linear-gradient(90deg,#0a192f 1px,transparent 1px);background-size:32px 32px;pointer-events:none;\" data-kid=\"22\"></div>\n\n      \n      <div id=\"hero-badge\" style=\"display:inline-flex;align-items:center;gap:8px;background:#ecfeff;border:1px solid #06b6d4;border-radius:2px;padding:6px 14px;width:fit-content;margin-bottom:28px;\" data-kid=\"23\">\n        <span class=\"pulse-dot\" style=\"width:6px;height:6px;border-radius:50%;background:#06b6d4;display:inline-block;flex-shrink:0;\" data-kid=\"24\"></span>\n        <span class=\"font-space\" style=\"font-size:11px;font-weight:600;color:#06b6d4;letter-spacing:1.5px;text-transform:uppercase;\" data-kid=\"25\">Đặt vé trực tuyến nhanh chóng</span>\n      </div>\n\n      \n      <h1 id=\"hero-heading\" class=\"font-space\" style=\"font-size:52px;font-weight:700;color:#0a192f;line-height:1.06;letter-spacing:-2px;margin:0 0 16px;\" data-kid=\"26\">\n        Hành trình<br data-kid=\"27\">của bạn<br data-kid=\"28\"><span style=\"color:#e85d04;\" data-kid=\"29\">bắt đầu</span><br data-kid=\"30\">từ đây\n      </h1>\n      <p id=\"hero-sub\" style=\"font-size:14.5px;color:#64748b;margin:0 0 32px;line-height:1.65;max-width:360px;\" data-kid=\"31\">Đặt vé xe khách toàn quốc dễ dàng, nhanh chóng — hơn 2,500 chuyến mỗi ngày từ 150+ nhà xe uy tín.</p>\n\n    \n      <div id=\"hero-card\" style=\"background:#fff;border:1px solid #e2e8f0;box-shadow:0 16px 56px rgba(10,25,47,0.13),0 2px 8px rgba(10,25,47,0.05);padding:24px;border-radius:6px;position:relative;\" data-kid=\"32\">\n        \n        <div style=\"position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#e85d04,#f97316);border-radius:6px 6px 0 0;\" data-kid=\"33\"></div>\n        \n        <div style=\"position:absolute;top:-12px;right:20px;background:#0a192f;color:#fff;font-size:10px;font-weight:600;padding:4px 10px;border-radius:2px;display:flex;align-items:center;gap:5px;\" data-kid=\"34\"><span class=\"pulse-dot\" style=\"width:5px;height:5px;border-radius:50%;background:#06b6d4;display:inline-block;flex-shrink:0;\" data-kid=\"35\"></span>4,218 kết quả hôm nay</div>\n\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;\" data-kid=\"36\">\n          <div style=\"border:1px solid #e2e8f0;padding:12px 14px;border-radius:3px;display:flex;align-items:center;gap:10px;cursor:pointer;background:#fafafa;\" data-kid=\"37\">\n            <i class=\"ti ti-map-pin\" style=\"color:#e85d04;font-size:17px;flex-shrink:0;\" data-kid=\"38\"></i>\n            <div data-kid=\"39\">\n              <div style=\"font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;\" data-kid=\"40\">Điểm đi</div>\n              <div class=\"font-space\" style=\"font-size:14px;font-weight:700;color:#0a192f;margin-top:1px;\" data-kid=\"41\">Hà Nội</div>\n            </div>\n          </div>\n          <div style=\"border:1px solid #e2e8f0;padding:12px 14px;border-radius:3px;display:flex;align-items:center;gap:10px;cursor:pointer;background:#fafafa;\" data-kid=\"42\">\n            <i class=\"ti ti-map-pin-filled\" style=\"color:#0a192f;font-size:17px;flex-shrink:0;\" data-kid=\"43\"></i>\n            <div data-kid=\"44\">\n              <div style=\"font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;\" data-kid=\"45\">Điểm đến</div>\n              <div class=\"font-space\" style=\"font-size:14px;font-weight:700;color:#0a192f;margin-top:1px;\" data-kid=\"46\">Đà Nẵng</div>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;\" data-kid=\"47\">\n          <div style=\"border:1px solid #e2e8f0;padding:12px 14px;border-radius:3px;display:flex;align-items:center;gap:10px;cursor:pointer;background:#fafafa;\" data-kid=\"48\">\n            <i class=\"ti ti-calendar\" style=\"color:#e85d04;font-size:17px;flex-shrink:0;\" data-kid=\"49\"></i>\n            <div data-kid=\"50\">\n              <div style=\"font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;\" data-kid=\"51\">Ngày đi</div>\n              <div class=\"font-space\" style=\"font-size:14px;font-weight:700;color:#0a192f;margin-top:1px;\" data-kid=\"52\">20/06/2025</div>\n            </div>\n          </div>\n          <div style=\"border:1px solid #e2e8f0;padding:12px 14px;border-radius:3px;display:flex;align-items:center;gap:10px;cursor:pointer;background:#fafafa;\" data-kid=\"53\">\n            <i class=\"ti ti-users\" style=\"color:#e85d04;font-size:17px;flex-shrink:0;\" data-kid=\"54\"></i>\n            <div data-kid=\"55\">\n              <div style=\"font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;\" data-kid=\"56\">Hành khách</div>\n              <div class=\"font-space\" style=\"font-size:14px;font-weight:700;color:#0a192f;margin-top:1px;\" data-kid=\"57\">1 người</div>\n            </div>\n          </div>\n        </div>\n\n        <button class=\"btn-search font-space\" style=\"width:100%;background:#e85d04;color:#fff;font-size:15px;font-weight:700;padding:15px;border:none;border-radius:3px;cursor:pointer;letter-spacing:0.5px;display:flex;align-items:center;justify-content:center;gap:8px;\" data-kid=\"58\">\n          <i class=\"ti ti-search\" style=\"font-size:18px;\" data-kid=\"59\"></i>\n          Tìm chuyến xe\n        </button>\n      </div>\n\n      \n      <div id=\"hero-trust\" style=\"display:flex;gap:24px;margin-top:24px;\" data-kid=\"60\">\n        <div style=\"display:flex;align-items:center;gap:7px;\" data-kid=\"61\">\n          <i class=\"ti ti-shield-check\" style=\"color:#06b6d4;font-size:15px;\" data-kid=\"62\"></i>\n          <span style=\"font-size:12px;color:#64748b;font-weight:500;\" data-kid=\"63\">Thanh toán bảo mật</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:7px;\" data-kid=\"64\">\n          <i class=\"ti ti-clock\" style=\"color:#06b6d4;font-size:15px;\" data-kid=\"65\"></i>\n          <span style=\"font-size:12px;color:#64748b;font-weight:500;\" data-kid=\"66\">Xác nhận tức thì</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:7px;\" data-kid=\"67\">\n          <i class=\"ti ti-headset\" style=\"color:#06b6d4;font-size:15px;\" data-kid=\"68\"></i>\n          <span style=\"font-size:12px;color:#64748b;font-weight:500;\" data-kid=\"69\">Hỗ trợ 24/7</span>\n        </div>\n      </div>\n    </div>\n\n    \n    <div style=\"flex:1;position:relative;overflow:hidden;\" data-kid=\"70\">\n      <video src=\"https://videos.pexels.com/video-files/4203742/4203742-sd_960_540_24fps.mp4\" poster=\"https://images.pexels.com/videos/4203742/pexels-photo-4203742.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" style=\"width:100%;height:100%;object-fit:cover;\" data-kid=\"71\"></video>\n\n      \n      <div style=\"position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,25,47,0.72) 0%,rgba(10,25,47,0.25) 60%,rgba(10,25,47,0.45) 100%);\" data-kid=\"72\"></div>\n\n      \n      <div style=\"position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;\" data-kid=\"73\">\n        <div class=\"font-space\" style=\"font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:#06b6d4;margin-bottom:12px;\" data-kid=\"74\">MẠNG LƯỚI TOÀN QUỐC</div>\n        <div class=\"font-space\" style=\"font-size:80px;font-weight:700;letter-spacing:-3px;line-height:1;color:#fff;\" data-kid=\"75\">63</div>\n        <div style=\"font-size:13px;color:rgba(255,255,255,0.6);letter-spacing:2px;text-transform:uppercase;margin-top:4px;\" data-kid=\"76\">Tỉnh thành</div>\n        <div style=\"margin-top:24px;display:flex;gap:24px;justify-content:center;\" data-kid=\"77\">\n          <div style=\"text-align:center;\" data-kid=\"78\">\n            <div class=\"font-space\" style=\"font-size:22px;font-weight:700;color:#fff;\" data-kid=\"79\">2,500+</div>\n            <div style=\"font-size:11px;color:rgba(255,255,255,0.5);margin-top:2px;\" data-kid=\"80\">chuyến/ngày</div>\n          </div>\n          <div style=\"width:1px;background:rgba(255,255,255,0.15);\" data-kid=\"81\"></div>\n          <div style=\"text-align:center;\" data-kid=\"82\">\n            <div class=\"font-space\" style=\"font-size:22px;font-weight:700;color:#fff;\" data-kid=\"83\">150+</div>\n            <div style=\"font-size:11px;color:rgba(255,255,255,0.5);margin-top:2px;\" data-kid=\"84\">nhà xe</div>\n          </div>\n          <div style=\"width:1px;background:rgba(255,255,255,0.15);\" data-kid=\"85\"></div>\n          <div style=\"text-align:center;\" data-kid=\"86\">\n            <div class=\"font-space\" style=\"font-size:22px;font-weight:700;color:#fff;\" data-kid=\"87\">1M+</div>\n            <div style=\"font-size:11px;color:rgba(255,255,255,0.5);margin-top:2px;\" data-kid=\"88\">khách hàng</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div style=\"position:absolute;top:24px;right:24px;background:rgba(10,25,47,0.8);border:1px solid rgba(6,182,212,0.3);padding: