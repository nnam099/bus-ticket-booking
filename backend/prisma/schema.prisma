// Prisma Schema - Bus Ticket Booking System
// Based on system requirements and ERD diagram

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// IDENTITY & ACCESS MANAGEMENT
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  isAnonymized Boolean  @default(false) @map("is_anonymized")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles    UserRole[]
  customer     Customer?
  busOperator  BusOperator?
  staff        Staff?
  auditLogs    AuditLog[]
  otpCodes     OtpCode[]
  notifications Notification[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // CUSTOMER, BUS_OPERATOR, STAFF, ADMIN
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String
  purpose   String   // REGISTER, RESET_PASSWORD, DELETE_ACCOUNT, PAYMENT
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

// ==========================================
// CUSTOMER
// ==========================================

model Customer {
  id            String  @id @default(uuid())
  userId        String  @unique @map("user_id")
  fullName      String  @map("full_name")
  dateOfBirth   DateTime? @map("date_of_birth")
  avatarUrl     String? @map("avatar_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders  Order[]
  reviews Review[]

  @@map("customers")
}

// ==========================================
// BUS OPERATOR
// ==========================================

model BusOperator {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  companyName     String  @map("company_name")
  licenseNumber   String  @unique @map("license_number")
  hotline         String
  address         String
  description     String? @db.Text
  logoUrl         String? @map("logo_url")
  isApproved      Boolean @default(false) @map("is_approved")
  approvedAt      DateTime? @map("approved_at")
  approvedBy      String? @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  routes       Route[]
  staffs       Staff[]
  depots       Depot[]

  @@map("bus_operators")
}

// ==========================================
// STAFF / DRIVER
// ==========================================

model Staff {
  id           String  @id @default(uuid())
  userId       String  @unique @map("user_id")
  operatorId   String  @map("operator_id")
  fullName     String  @map("full_name")
  role         String  // DRIVER, ASSISTANT
  licenseNo    String? @map("license_no")
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  operator  BusOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  tripStaffs TripStaff[]
  leaves    StaffLeave[]
  shifts    StaffShift[]

  @@map("staffs")
}

model StaffLeave {
  id          String   @id @default(uuid())
  staffId     String   @map("staff_id")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  reason      String   // SICK, WEEKLY_OFF, PERSONAL
  status      String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now()) @map("created_at")
  
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  @@index([staffId, startDate, endDate])
  @@map("staff_leaves")
}

// ==========================================
// FLEET & ROUTE MANAGEMENT
// ==========================================

model VehicleType {
  id          String @id @default(uuid())
  name        String // VD: Limousine 22, Giường nằm 40
  seatCount   Int    @map("seat_count")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  vehicles     Vehicle[]
  seatLayouts  SeatLayout[]
  schedules    Schedule[]

  @@map("vehicle_types")
}

model SeatLayout {
  id            String @id @default(uuid())
  vehicleTypeId String @map("vehicle_type_id")
  seatCode      String @map("seat_code") // A1, A2, B1...
  floor         Int    @default(1)
  row           Int
  col           Int
  seatType      String @map("seat_type") // SINGLE, DOUBLE
  createdAt     DateTime @default(now()) @map("created_at")

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  tripSeats   TripSeat[]

  @@unique([vehicleTypeId, seatCode])
  @@map("seat_layouts")
}

model Vehicle {
  id             String @id @default(uuid())
  operatorId     String @map("operator_id")
  vehicleTypeId  String @map("vehicle_type_id")
  licensePlate   String @unique @map("license_plate")
  manufactureYear Int?  @map("manufacture_year")
  isActive       Boolean @default(true) @map("is_active")
  currentDepotId String? @map("current_depot_id")
  status         String  @default("AVAILABLE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  operator    BusOperator @relation(fields: [operatorId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  currentDepot Depot?     @relation("VehicleCurrentDepot", fields: [currentDepotId], references: [id])
  trips       Trip[]
  maintenance VehicleMaintenance[]
  locationHistory VehicleLocationHistory[]

  @@map("vehicles")
}

model Route {
  id             String  @id @default(uuid())
  operatorId     String  @map("operator_id")
  originCity     String  @map("origin_city")
  destinationCity String @map("destination_city")
  originAddress  String  @map("origin_address")
  destinationAddress String @map("destination_address")
  distanceKm     Float?  @map("distance_km")
  durationMinutes Int?   @map("duration_minutes")
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  operator BusOperator @relation(fields: [operatorId], references: [id])
  trips    Trip[]
  routeStops RouteStop[]
  schedules Schedule[]

  @@index([originCity, destinationCity])
  @@map("routes")
}

model RouteStop {
  id          String   @id @default(uuid())
  routeId     String   @map("route_id")
  stopName    String   @map("stop_name")
  address     String
  order       Int      // Thứ tự điểm dừng từ điểm xuất phát (1, 2, 3...)
  durationMin Int      @map("duration_min") // Thời gian dự kiến di chuyển từ điểm đi (phút)
  
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  
  @@index([routeId, order])
  @@map("route_stops")
}

// ==========================================
// TRIP OPERATIONS
// ==========================================

model Trip {
  id              String   @id @default(uuid())
  routeId         String   @map("route_id")
  vehicleId       String   @map("vehicle_id")
  departureTime   DateTime @map("departure_time")
  estimatedArrival DateTime @map("estimated_arrival")
  basePrice       Decimal  @map("base_price") @db.Decimal(12, 0)
  status          String   @default("SCHEDULED")
  // SCHEDULED | BOARDING | DEPARTED | COMPLETED | DELAYED | CANCELLED
  cancelReason    String?  @map("cancel_reason") @db.Text
  version         Int      @default(1)
  depotId         String?  @map("depot_id")
  actualDeparture DateTime? @map("actual_departure")
  actualArrival   DateTime? @map("actual_arrival")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  route      Route       @relation(fields: [routeId], references: [id])
  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id])
  depot      Depot?      @relation(fields: [depotId], references: [id])
  tripStaffs TripStaff[]
  tripSeats  TripSeat[]
  eventLogs  TripEventLog[]
  incidents  TripIncident[]
  locationHistory VehicleLocationHistory[]

  @@index([departureTime, status])
  @@index([routeId, departureTime, status]) // Search optimization
  @@map("trips")
}

model TripStaff {
  tripId    String   @map("trip_id")
  staffId   String   @map("staff_id")
  role      String   // DRIVER, ASSISTANT
  createdAt DateTime @default(now()) @map("created_at")

  trip  Trip  @relation(fields: [tripId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])

  @@id([tripId, staffId])
  @@map("trip_staffs")
}

// ==========================================
// CORE SEAT INVENTORY
// ==========================================

model TripSeat {
  id           String   @id @default(uuid())
  tripId       String   @map("trip_id")
  seatLayoutId String   @map("seat_layout_id")
  status       String   @default("AVAILABLE")
  // AVAILABLE | PROCESSING | BOOKED | UNAVAILABLE
  lockedAt     DateTime? @map("locked_at")
  lockedBy     String?  @map("locked_by") // customerId
  lockExpiresAt DateTime? @map("lock_expires_at")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  trip        Trip         @relation(fields: [tripId], references: [id])
  seatLayout  SeatLayout   @relation(fields: [seatLayoutId], references: [id])
  ticketDetails TicketDetail[]

  @@unique([tripId, seatLayoutId])
  @@index([tripId, status])
  @@index([status, lockExpiresAt]) // Cron job optimization
  @@map("trip_seats")
}

// ==========================================
// TRANSACTIONS & PAYMENTS
// ==========================================

model Order {
  id           String   @id @default(uuid())
  publicCode   String?  @unique @map("public_code")
  customerId   String   @map("customer_id")
  totalAmount  Decimal  @map("total_amount") @db.Decimal(12, 0)
  status       String   @default("PENDING")
  // PENDING | PAID | CANCELLED | REFUNDED
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer      Customer       @relation(fields: [customerId], references: [id])
  payments      Payment[]
  ticketDetails TicketDetail[]

  @@index([customerId])
  @@map("orders")
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  amount          Decimal  @db.Decimal(12, 0)
  method          String   // E_WALLET | BANK_CARD | BANK_TRANSFER | CASH
  gateway         String?  // VNPAY | MOMO | ...
  gatewayTxnId    String?  @map("gateway_txn_id")
  status          String   @default("PENDING")
  // PENDING | SUCCESS | FAILED | REFUNDED
  paidAt          DateTime? @map("paid_at")
  refundedAt      DateTime? @map("refunded_at")
  refundAmount    Decimal? @map("refund_amount") @db.Decimal(12, 0)
  createdAt       DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model TicketDetail {
  id           String   @id @default(uuid())
  publicCode   String?  @unique @map("public_code")
  orderId      String   @map("order_id")
  tripSeatId   String   @map("trip_seat_id")
  passengerName String  @map("passenger_name")
  passengerPhone String? @map("passenger_phone")
  price        Decimal  @db.Decimal(12, 0)
  qrCode       String?  @map("qr_code") @db.Text
  status       String   @default("PENDING")
  // PENDING | PAID | CHECKED_IN | COMPLETED | CANCELLED | REFUNDED
  checkedInAt  DateTime? @map("checked_in_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?  @map("cancel_reason") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id])
  tripSeat TripSeat @relation(fields: [tripSeatId], references: [id])
  review   Review?

  @@index([orderId])
  @@index([tripSeatId])
  @@index([status])
  @@map("ticket_details")
}

// ==========================================
// REVIEWS
// ==========================================

model Review {
  id             String  @id @default(uuid())
  ticketDetailId String  @unique @map("ticket_detail_id") // 1-1: must have real ticket
  customerId     String  @map("customer_id")
  rating         Int     // 1–5
  comment        String? @db.Text
  isApproved     Boolean @default(false) @map("is_approved")
  approvedBy     String? @map("approved_by")
  createdAt      DateTime @default(now()) @map("created_at")

  ticketDetail TicketDetail @relation(fields: [ticketDetailId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@map("reviews")
}

// ==========================================
// AUDIT & SYSTEM CONFIG
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  link      String?
  metadata  Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("system_configs")
}

// ==========================================
// ENTERPRISE TMS EXTENSIONS
// ==========================================

model Depot {
  id         String   @id @default(uuid())
  operatorId String   @map("operator_id")
  name       String
  address    String
  capacity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  operator   BusOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  parkingSlots ParkingSlot[]
  parkedVehicles Vehicle[] @relation("VehicleCurrentDepot")
  trips      Trip[]
  maintenance VehicleMaintenance[]

  @@unique([operatorId, name])
  @@map("depots")
}

model ParkingSlot {
  id               String   @id @default(uuid())
  depotId          String   @map("depot_id")
  slotCode         String   @map("slot_code")
  status           String   @default("AVAILABLE")
  currentVehicleId String?  @map("current_vehicle_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  depot Depot @relation(fields: [depotId], references: [id], onDelete: Cascade)
  
  @@unique([depotId, slotCode])
  @@index([depotId, status])
  @@map("parking_slots")
}

model Schedule {
  id            String   @id @default(uuid())
  routeId       String   @map("route_id")
  vehicleTypeId String   @map("vehicle_type_id")
  cronRule      String   @map("cron_rule")
  startDate     DateTime @map("start_date")
  endDate       DateTime? @map("end_date")
  basePrice     Decimal  @map("base_price") @db.Decimal(12, 0)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  route       Route       @relation(fields: [routeId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  exceptions  ScheduleException[]

  @@map("schedules")
}

model ScheduleException {
  id          String   @id @default(uuid())
  scheduleId  String   @map("schedule_id")
  exceptionDate DateTime @map("exception_date")
  action      String   // CANCEL, PRICE_MULTIPLIER
  multiplier  Decimal? @db.Decimal(4, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, exceptionDate])
  @@map("schedule_exceptions")
}

model TripEventLog {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  eventType  String   @map("event_type") // VEHICLE_INSPECTED, DRIVER_CHECKIN, DEPARTED, DELAYED
  actorId    String?  @map("actor_id") // User ID
  timestamp  DateTime @default(now())
  metadata   Json?
  
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, eventType])
  @@map("trip_event_logs")
}

model TripIncident {
  id          String   @id @default(uuid())
  tripId      String   @map("trip_id")
  type        String   // BREAKDOWN, TRAFFIC, WEATHER
  description String   @db.Text
  severity    String   // LOW, HIGH, CRITICAL
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, type])
  @@map("trip_incidents")
}

model VehicleMaintenance {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  depotId     String?  @map("depot_id")
  type        String   // SCHEDULED, REPAIR, CLEANING
  description String   @db.Text
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  cost        Decimal? @db.Decimal(12, 0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  depot       Depot?   @relation(fields: [depotId], references: [id])

  @@index([vehicleId, status])
  @@map("vehicle_maintenances")
}

model VehicleLocationHistory {
  id         String   @id @default(uuid())
  vehicleId  String   @map("vehicle_id")
  tripId     String?  @map("trip_id")
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([vehicleId, recordedAt])
  @@map("vehicle_location_histories")
}

model StaffShift {
  id                  String   @id @default(uuid())
  staffId             String   @map("staff_id")
  clockIn             DateTime @map("clock_in")
  clockOut            DateTime? @map("clock_out")
  totalDrivingMinutes Int      @default(0) @map("total_driving_minutes")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  staff               Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, clockIn])
  @@map("staff_shifts")
}
